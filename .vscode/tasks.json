{
  // Run with Terminal > Run Task… (or Ctrl+Shift+P > "Tasks: Run Task") and pick "Run web app and bot".
  // Web app, tunnel and bot open side by side in one split terminal (same "group"). The tunnel writes
  // its new HTTPS address into bot/.env on every start, and the bot switches to it by itself.
  // Stop one with Ctrl+C in its pane, or all with "Tasks: Terminate Task".
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Database",
      "detail": "Local Postgres 17 in Docker (needs Docker Desktop running); exits once the database is ready",
      "type": "shell",
      "command": "npm run db:up",
      "options": { "cwd": "${workspaceFolder}/app" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "silent", "clear": true }
    },
    {
      "label": "Web app",
      "detail": "Next.js dev server on http://localhost:3000",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/app" },
      "dependsOn": ["Database"],
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "run", "reveal": "always", "clear": true }
    },
    {
      "label": "Tunnel",
      "detail": "HTTPS tunnel to the web app for Telegram; writes its address into bot/.env",
      "type": "shell",
      "command": "npm run tunnel",
      "options": { "cwd": "${workspaceFolder}/bot" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "run", "reveal": "always", "clear": true }
    },
    {
      "label": "Telegram bot",
      "detail": "Bot; restarts on code changes and follows address changes in bot/.env",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/bot" },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "run", "reveal": "always", "clear": true }
    },
    {
      "label": "Run web app and bot",
      "detail": "Starts the web app, tunnel and bot side by side in a split terminal",
      "dependsOn": ["Web app", "Tunnel", "Telegram bot"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
